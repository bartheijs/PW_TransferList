<?xml version="1.0" encoding="utf-8"?>
<widget id="conclusion low code company.transferlist.TransferList" pluginWidget="true" needsEntityContext="false" offlineCapable="true"
        supportedPlatform="Web"
        xmlns="http://www.mendix.com/widget/1.0/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.mendix.com/widget/1.0/ ../node_modules/mendix/custom_widget.xsd">
    <name>Transfer List</name>
    <description>A Mendix widget to transfer objects from one list to another</description>
    <icon/>
    <properties>
        <propertyGroup caption="General">
            <property key="leftDataSource" type="datasource" isList="true">
                <caption>Left data source</caption>
                <description>Data source for the left panel items</description>
            </property>
            <property key="leftContent" type="widgets" dataSource="leftDataSource" required="false">
                <caption>Left panel content</caption>
                <description>Content template for each left panel item</description>
            </property>
            <property key="leftLabel" type="widgets" required="false">
                <caption>Left panel label</caption>
                <description>Label shown above the left panel</description>
            </property>
            <property key="rightDataSource" type="datasource" isList="true">
                <caption>Right data source</caption>
                <description>Data source for the right panel items</description>
            </property>
            <property key="rightContent" type="widgets" dataSource="rightDataSource" required="false">
                <caption>Right panel content</caption>
                <description>Content template for each right panel item</description>
            </property>
            <property key="rightLabel" type="widgets" required="false">
                <caption>Right panel label</caption>
                <description>Label shown above the right panel</description>
            </property>
            <property key="panelHeightMode" type="enumeration" defaultValue="fixed">
                <caption>Panel height mode</caption>
                <description>Fixed: set an explicit height. Fill: expand to fill the parent container.</description>
                <enumerationValues>
                    <enumerationValue key="fixed">Fixed height</enumerationValue>
                    <enumerationValue key="fill">Fill parent container</enumerationValue>
                </enumerationValues>
            </property>
            <property key="panelHeight" type="integer" defaultValue="300">
                <caption>Panel height</caption>
                <description>Numeric height value (fixed mode only)</description>
            </property>
            <property key="panelHeightUnit" type="enumeration" defaultValue="px">
                <caption>Panel height unit</caption>
                <description>CSS unit for the panel height (fixed mode only)</description>
                <enumerationValues>
                    <enumerationValue key="px">px</enumerationValue>
                    <enumerationValue key="rem">rem</enumerationValue>
                    <enumerationValue key="vh">vh</enumerationValue>
                </enumerationValues>
            </property>
        </propertyGroup>
        <propertyGroup caption="Interaction">
            <property key="interactionMode" type="enumeration" defaultValue="click">
                <caption>Interaction mode</caption>
                <description>How users interact with items to move them</description>
                <enumerationValues>
                    <enumerationValue key="click">Click</enumerationValue>
                    <enumerationValue key="dblclick">Double click</enumerationValue>
                    <enumerationValue key="multiselect">Multi select</enumerationValue>
                    <enumerationValue key="dragdrop">Drag and drop</enumerationValue>
                </enumerationValues>
            </property>
            <property key="showMoveAll" type="boolean" defaultValue="false">
                <caption>Show move all buttons</caption>
                <description>Show buttons to move all items to either panel at once</description>
            </property>
            <property key="onAdd" type="action" dataSource="leftDataSource" required="false">
                <caption>Add action</caption>
                <description>Action executed when an item moves to the right panel</description>
            </property>
            <property key="onRemove" type="action" dataSource="rightDataSource" required="false">
                <caption>Remove action</caption>
                <description>Action executed when an item moves to the left panel</description>
            </property>
        </propertyGroup>
        <propertyGroup caption="Search">
            <property key="showLeftSearch" type="boolean" defaultValue="false">
                <caption>Show left search</caption>
                <description>Show a search input above the left panel</description>
            </property>
            <property key="leftSearchAttribute" type="textTemplate" dataSource="leftDataSource" required="false">
                <caption>Left search text</caption>
                <description>Text template matched against the search query in the left panel</description>
            </property>
            <property key="showRightSearch" type="boolean" defaultValue="false">
                <caption>Show right search</caption>
                <description>Show a search input above the right panel</description>
            </property>
            <property key="rightSearchAttribute" type="textTemplate" dataSource="rightDataSource" required="false">
                <caption>Right search text</caption>
                <description>Text template matched against the search query in the right panel</description>
            </property>
        </propertyGroup>
    </properties>
</widget>
